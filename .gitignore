# Compilação: executáveis e arquivos intermediários
/projeto-*/compilacao/
*.o
*.obj
*.exe
a.out

# Saídas geradas pelo Mandelbrot
# Ignorar somente dentro das pastas de saídas.
/projeto-*/saidas/**/*.bin
/projeto-*/saidas/**/*.pgm
/projeto-*/saidas/**/*.ppm
/projeto-*/saidas/**/*.png

# Python: ambiente virtual e cache dos programas auxiliares
.venv/
__pycache__/
*.py[cod]

# LaTeX: arquivos auxiliares gerados na compilação
*.aux
*.bbl
*.blg
*.bcf
*.run.xml
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb

# Logs e intermediários do LaTeX, sem esconder logs experimentais
/projeto-*/relatorio/**/*.log
/projeto-*/relatorio/**/*.out
/projeto-*/apresentacao/**/*.log
/projeto-*/apresentacao/**/*.out

# Arquivos temporários de editores e do sistema operacional
*.swp
*.swo
*~
.DS_Store
Thumbs.db