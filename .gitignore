/projeto-2-mpi/resultados/**/*.pgm
/projeto-2-mpi/resultados/**/*.ppm
/projeto-2-mpi/resultados/**/*.png


# Python: ambiente virtual e cache dos programas auxiliares
.venv/
__pycache__/
*.py[cod]

# LaTeX: arquivos auxiliares gerados na compilação
*.aux
*.bbl
*.blg
*.bcf
*.run.xml
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb

